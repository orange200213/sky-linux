#!/bin/sh
# sky-linux: PID 1.
#
# Everything this box does at boot is an OpenRC service; this file only sets up
# what the service manager needs and then hands over to openrc-init.
#
# Two things it must not assume:
#
#  * that the mount points exist. The rootfs image has shipped without /proc,
#    /sys and /tmp, and this script used to mount with 2>/dev/null and silently
#    boot a system with no /proc at all (no ptys, sshd half-working, OpenRC
#    unable to run).
#  * that the initramfs left anything mounted. It usually did, but that is a
#    property of the boot image, not of this rootfs.
#
# Hence: mkdir everything, mount everything, ignore only real duplicates.
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

mkdir -p /proc /sys /dev /run
mount -t proc     proc     /proc    2>/dev/null
mount -t sysfs    sysfs    /sys     2>/dev/null
mount -t devtmpfs devtmpfs /dev     2>/dev/null

mkdir -p /dev/pts /dev/shm /dev/mqueue
mount -t devpts devpts /dev/pts 2>/dev/null
mount -t tmpfs  tmpfs  /dev/shm 2>/dev/null

# OpenRC keeps all of its state in /run, and Alpine's bootmisc wipes the
# *underlying* /run directory on / (mount --bind / && rm -rf $dir/run/*) - that
# is only safe when a tmpfs is mounted over it, which the initramfs used to do.
# If /run stays on the ext4 root, bootmisc deletes /run/openrc/softlevel in the
# middle of the boot runlevel and the "default" runlevel then believes OpenRC
# never booted this system and refuses to start anything.
mount -t tmpfs -o mode=0755,nosuid tmpfs /run 2>/dev/null

# This board has no usable RTC: /dev/rtc0 reads 1970-01-05, so the clock starts
# 56 years behind the rootfs files. OpenRC compares /etc mtimes with the clock
# and then reports "clock skew" and re-caches the dependency tree on every
# invocation, mid-boot. The rootfs' own newest /etc mtime is a sound lower
# bound for "now" on a read-only-DTB device like this, and it also keeps TLS
# (apk) working.
if [ "$(date +%Y)" -lt 2024 ]; then
	newest=0
	for f in /etc/init.d/* /etc/conf.d/* /etc/rc.conf /etc/inittab /etc/fstab /etc/passwd; do
		m=$(stat -c %Y "$f" 2>/dev/null) || continue
		[ "$m" -gt "$newest" ] && newest=$m
	done
	# The dependency tree is written after this and must not look older than
	# the /etc files OpenRC compares it with, so leave a margin.
	[ "$newest" -gt 0 ] && date -u -s "@$((newest + 3600))" >/dev/null 2>&1
fi

if [ ! -x /sbin/openrc-init ]; then
	echo "sky-init: /sbin/openrc-init missing, falling back to /init.pre-openrc" > /dev/kmsg
	[ -f /init.pre-openrc ] && exec /bin/sh /init.pre-openrc
	exec /bin/sh
fi

# PID 1's stdout is /dev/console, i.e. the gadget serial port. If the host is
# not draining that port (ModemManager grabs /dev/ttyACM0 and only probes it),
# a write to it blocks, and the boot stops at the first message OpenRC prints.
# Give the service manager a file instead; the kernel still prints to the
# console on its own.
mkdir -p /var/log
exec >>/var/log/openrc-boot.log 2>&1 </dev/null

# Safety net: if OpenRC does not get sshd up, save what the box looked like and
# put the old init back, so a bad boot costs one reboot instead of a manual
# reflash. Nothing else in the boot can recover the box, because without sshd
# there is no way in.
(
	i=0
	while [ $i -lt 60 ]; do
		i=$((i + 1))
		sleep 2
		netstat -ltn 2>/dev/null | grep -q ':22 ' && exit 0
	done
	{
		date
		echo "--- /proc/1/cmdline ---"; tr '\0' ' ' < /proc/1/cmdline; echo
		echo "--- ps ---"; ps
		echo "--- listeners ---"; netstat -ltn
		echo "--- /run/openrc ---"; ls -la /run/openrc
		echo "--- rc-status ---"; rc-status --all
		echo "--- dmesg ---"; dmesg
	} >/var/log/boot-failed.log 2>&1
	echo "sky-init: sshd not up after 120s, restoring /init.pre-openrc and rebooting" > /dev/kmsg
	[ -f /init.pre-openrc ] && cp -f /init.pre-openrc /init
	sync
	reboot -f
) &

exec /sbin/openrc-init
