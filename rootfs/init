#!/bin/sh
# sky-linux rootfs init (PID 1 after switch_root)
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# ADSP: the remoteproc auto-boot fires before switch_root, so /lib/firmware is
# not there yet and it fails. Retry in the background until it stays up; the
# battery/charger power supplies (pmic-glink -> battmgr) need it.
(
	i=0
	while [ $i -lt 60 ]; do
		i=$((i + 1))
		for r in /sys/class/remoteproc/remoteproc*; do
			[ "$(cat $r/name 2>/dev/null)" = adsp ] || continue
			[ "$(cat $r/state 2>/dev/null)" = running ] && exit 0
			/bin/busybox echo start > $r/state 2>/dev/null
		done
		/bin/busybox sleep 2
	done
) &
mount -t proc     proc     /proc     2>/dev/null
mount -t sysfs    sysfs    /sys      2>/dev/null
mount -t devtmpfs devtmpfs /dev      2>/dev/null
mkdir -p /dev/pts /dev/shm
mount -t devpts   devpts   /dev/pts  2>/dev/null
mount -t tmpfs    tmpfs    /dev/shm  2>/dev/null
mkdir -p /run/sshd /var/empty /log

insmod /lib/modules/$(uname -r)/extra/ktd3136.ko 2>/dev/null
insmod /lib/modules/$(uname -r)/extra/panel-xiaomi-m19.ko clock_khz=$(cat /etc/sky-panel-clock 2>/dev/null || echo 276180) 2>/dev/null
hostname sky 2>/dev/null

# USB network (the gadget itself is set up by the initramfs)
if [ -d /sys/class/net/usb0 ]; then
	ip link set usb0 up 2>/dev/null
	ip addr add 192.168.7.1/24 dev usb0 2>/dev/null
fi

# keep the DHCP server alive so the host always gets an address
if [ -x /usr/sbin/udhcpd ] && [ -c /sys/class/net/usb0 ]; then
	cat > /run/udhcpd.conf <<'CONF'
start 192.168.7.10
end 192.168.7.50
interface usb0
lease_file /run/udhcpd.leases
opt router 192.168.7.1
opt dns 192.168.7.1
CONF
	udhcpd /run/udhcpd.conf 2>/dev/null
fi

# kill a sshd inherited from the initramfs: it holds :22 with a root that is gone
pkill -f "/sbin/sshd" 2>/dev/null
sleep 1
[ -f /etc/ssh/ssh_host_ed25519_key ] || ssh-keygen -A >/dev/null 2>&1
/usr/sbin/sshd 2>/dev/null
echo "sky-rootfs: up ($(date -u +%H:%M:%S) UTC), ip $(ip -4 -br addr show usb0 2>/dev/null | awk '{print $3}')" > /dev/kmsg 2>/dev/null

# root shell on the USB serial console, restarted on hangup
while :; do
	if [ -c /dev/ttyGS0 ]; then
		setsid sh -c 'exec sh </dev/ttyGS0 >/dev/ttyGS0 2>&1' 2>/dev/null
	fi
	sleep 1
done

# power key: kill the backlight as soon as the key goes down. Holding
# vol-down + power makes the PMIC reset the SoC after ~10 s, and nothing in
# Linux turns the panel off by itself, so the screen would keep glowing until
# ABL takes over. A short tap toggles the screen like a normal phone.
(
	while :; do
		ev=$($BB od -An -tu1 -N24 /dev/input/event1 2>/dev/null)
		[ -z "$ev" ] && { $BB sleep 1; continue; }
		set -- $ev
		[ "$17" = "1" ] && [ "$19" = "116" ] || continue
		[ "$21" = "1" ] || continue
		bl=/sys/class/backlight/ktd3136-backlight
		if [ "$(cat $bl/brightness)" = "0" ]; then
			$BB cat $bl/max_brightness > $bl/brightness
		else
			$BB echo 0 > $bl/brightness
		fi
	done
) &

