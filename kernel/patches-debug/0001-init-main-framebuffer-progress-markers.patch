+/* render the panic message on the splash framebuffer: 2x scaled 8x16 glyphs */
+void sky_panic_print(const char *buf)
+{
+	unsigned x = 32, y = 120;
+	const unsigned char *g;
+	u32 col;
+	int gy, gx, sy;
+
+	if (!sky_fb_ensure())
+		return;
+	for (; *buf; buf++) {
+		char c = *buf;
+
+		if (c == '\n') {
+			x = 32; y += 34;
+			continue;
+		}
+		if (c < 0x20 || c > 0x7e)
+			c = '?';
+		if (x + 16 > 1048) {
+			x = 32; y += 34;
+		}
+		if (y + 32 > 2360)
+			return;
+		g = sky_font[c - 0x20];
+		for (gy = 0; gy < 16; gy++) {
+			for (gx = 0; gx < 8; gx++) {
+				col = (g[gy] & (0x80 >> gx)) ? 0x00ffffff : 0x00000000;
