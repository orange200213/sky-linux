+/* panic marker: thin bright red bar at the very top (the message is drawn
+ * below it by sky_panic_print(), so do not paint over the text area) */
+void sky_panic_mark(void)
+{
+	u32 *p;
+	unsigned i, j;
+
+	if (!sky_fb)
+		return;
+	/* whole screen = colour of the last stage reached; red bar on top = panic */
+	for (j = 0; j < 2460; j++) {
+		p = (u32 *)(sky_fb + j * 4320);
+		for (i = 0; i < 1080; i++)
+			p[i] = (sky_last_mark < 0) ? 0x00ffffff : sky_mark_color[sky_last_mark];
+	}
+	for (j = 0; j < 80; j++) {
+		p = (u32 *)(sky_fb + j * 4320);
+		for (i = 0; i < 1080; i++)
+			p[i] = 0x00ff0000;
+	}
+}
