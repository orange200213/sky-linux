+/*
+ * sky bring-up marker: paint a coloured block straight into the ABL splash
+ * framebuffer so boot progress is visible without any console. Local debug.
+ * n -> colour/x position: 0 red, 1 orange, 2 yellow, 3 lime, 4 green, 5 cyan,
+ * 6 blue, 7 violet, 8 magenta, 9 pink, 10 white, 11 grey, 12 teal, 13 brown,
+ * 14 gold.  x = 32 + n*70, y = 32, 64x64.
+ */
+#include <linux/io.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+
+static void __iomem *sky_fb;
+static int sky_last_mark = -1;
+static bool sky_fb_tried;
+
+static const u32 sky_mark_color[32] = {
+	0x00ff0000, 0x00ff8000, 0x00ffff00, 0x0080ff00,
+	0x0000ff00, 0x0000ffff, 0x000000ff, 0x008000ff,
+	0x00ff00ff, 0x00ff80c0, 0x00ffffff, 0x00808080,
+	0x00008080, 0x00804000, 0x00ffd700, 0x00404040,
+	0x00400000, 0x0000ff80, 0x00800080, 0x00a0a0a0,
+	0x00ffff80, 0x00ff0080, 0x000080ff, 0x0080ff80,
+	0x00ff4000, 0x0040ff00, 0x004000ff, 0x00ff0040,
+	0x0000ff40, 0x0040ffff, 0x00ff40ff, 0x00808000,
+};
+
+static void sky_dbg_mark(unsigned n)
+{
+	struct device_node *np;
+	struct resource res;
+	u32 *p;
+	unsigned i, j;
+
+	if (n >= 32)
+		return;
+	if (!sky_fb && !sky_fb_tried) {
+		sky_fb_tried = true;
+		np = of_find_node_by_path("/chosen/framebuffer@b8000000");
+		if (np && !of_address_to_resource(np, 0, &res))
+			sky_fb = ioremap(res.start, resource_size(&res));
+		of_node_put(np);
+	}
+	if (!sky_fb)
+		return;
+	sky_last_mark = n;
+	for (j = 0; j < 64; j++) {
+		p = (u32 *)(sky_fb + (200 + n * 70 + j) * 4320 + 960);
+		for (i = 0; i < 64; i++)
+			p[i] = sky_mark_color[n];
+	}
+}
