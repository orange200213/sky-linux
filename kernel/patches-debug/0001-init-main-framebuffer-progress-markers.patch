+static void __iomem *sky_fb_ensure(void)
+{
+	struct device_node *np;
+	struct resource res;
+
+	if (!sky_fb && !sky_fb_tried) {
+		sky_fb_tried = true;
+		np = of_find_node_by_path("/chosen/framebuffer@b8000000");
+		if (np && !of_address_to_resource(np, 0, &res))
+			sky_fb = ioremap(res.start, resource_size(&res));
+		of_node_put(np);
+	}
+	return sky_fb;
+}
