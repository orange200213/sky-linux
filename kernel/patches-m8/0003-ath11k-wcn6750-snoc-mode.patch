 static int ath11k_ahb_config_irq(struct ath11k_base *ab)
 {
+	struct ath11k_ahb *ab_ahb = ath11k_ahb_priv(ab);
 	int irq, irq_idx, i;
 	int ret;
 
@@ -648,7 +649,16 @@ static int ath11k_ahb_config_irq(struct ath11k_base *ab)
 		irq_idx = ATH11K_IRQ_CE0_OFFSET + i;
diff --git a/drivers/net/wireless/ath/ath11k/ahb.c b/drivers/net/wireless/ath/ath11k/ahb.c
index ec5bf5c9f..e2ec18f09 100644
--- a/drivers/net/wireless/ath/ath11k/ahb.c
+++ b/drivers/net/wireless/ath/ath11k/ahb.c
@@ -44,6 +44,22 @@ MODULE_DEVICE_TABLE(of, ath11k_ahb_of_match);
 
 #define ATH11K_IRQ_CE0_OFFSET 4
 
+/* SNOC variant: does the firmware own its MSA (fixed_fw_mem) or does it ask
+ * the host for DDR memory over QMI?  Both flows exist in the WLFW protocol.
+ */
+/* SNOC mode: map a larger membase window than the DT describes (MiB, 0 = DT) */
+static uint ath11k_snoc_membase_mib;
+module_param_named(snoc_membase_mib, ath11k_snoc_membase_mib, uint, 0644);
+MODULE_PARM_DESC(snoc_membase_mib, "SNOC mode: membase window size in MiB (0 = DT size)");
+
+static bool ath11k_snoc_probe;
+module_param_named(snoc_probe, ath11k_snoc_probe, bool, 0644);
+MODULE_PARM_DESC(snoc_probe, "probe WCSS register bases at bind (dangerous)");
+
+static bool ath11k_snoc_fixed_mem = true;
+module_param_named(snoc_fixed_mem, ath11k_snoc_fixed_mem, bool, 0644);
+MODULE_PARM_DESC(snoc_fixed_mem, "SNOC mode: firmware owns its MSA region");
+
 static const char *irq_name[ATH11K_IRQ_NUM_MAX] = {
 	"misc-pulse1",
 	"misc-latch",
@@ -469,7 +485,9 @@ static void ath11k_ahb_free_irq(struct ath11k_base *ab)
 		return ath11k_pcic_free_irq(ab);
 
 	ath11k_ahb_free_ce_irqs(ab, ab->hw_params.ce_count);
-	ath11k_ahb_free_ext_irq(ab);
+	/* the SNOC variant never configures the extended interrupts */
+	if (!ath11k_ahb_priv(ab)->snoc_ahb)
+		ath11k_ahb_free_ext_irq(ab);
 }
 
 static void ath11k_ahb_ce_tasklet(struct tasklet_struct *t)
@@ -632,6 +650,7 @@ static int ath11k_ahb_config_ext_irq(struct ath11k_base *ab)
 
 static int ath11k_ahb_config_irq(struct ath11k_base *ab)
 {
+	struct ath11k_ahb *ab_ahb = ath11k_ahb_priv(ab);
 	int irq, irq_idx, i;
 	int ret;
 
@@ -648,7 +667,16 @@ static int ath11k_ahb_config_irq(struct ath11k_base *ab)
 		irq_idx = ATH11K_IRQ_CE0_OFFSET + i;
 
 		tasklet_setup(&ce_pipe->intr_tq, ath11k_ahb_ce_tasklet);
-		irq = platform_get_irq_byname(ab->pdev, irq_name[irq_idx]);
+		if (ab_ahb->snoc_ahb)
+			irq = platform_get_irq(ab->pdev, i);
+		else
+			irq = platform_get_irq_byname(ab->pdev, irq_name[irq_idx]);
+		if (irq < 0) {
+			ath11k_err(ab, "failed to get irq for ce %d: %d\n",
+				   i, irq);
+			ath11k_ahb_free_ce_irqs(ab, i);
+			return irq;
+		}
 		ret = request_irq(irq, ath11k_ahb_ce_interrupt_handler,
 				  IRQF_TRIGGER_RISING, irq_name[irq_idx],
 				  ce_pipe);
@@ -661,6 +689,15 @@ static int ath11k_ahb_config_irq(struct ath11k_base *ab)
 		ab->irq_num[irq_idx] = irq;
 	}
 
+	/* The SNOC variant has no separate extended interrupts: the datapath
+	 * ring interrupts are not described in its DT. Leave them unconfigured
+	 * for now so that the bootstrap (MSA, BDF, WMI) can be tested.
+	 */
+	if (ab_ahb->snoc_ahb) {
+		ath11k_warn(ab, "snoc mode: extended interrupts not configured\n");
+		return 0;
+	}
+
 	/* Configure external interrupts */
 	ret = ath11k_ahb_config_ext_irq(ab);
 	if (ret) {
@@ -806,6 +843,200 @@ static const struct ath11k_hif_ops ath11k_ahb_hif_ops_ipq8074 = {
 	.power_up = ath11k_ahb_power_up,
 };
 
+/* the SNOC variant delivers CE interrupts on one GIC line per CE instead of
+ * the PCI MSI block, so the shared MSI helpers must not be used
+ */
+static int ath11k_ahb_get_user_msi_vector(struct ath11k_base *ab, char *user_name,
+					  int *num_vectors, u32 *user_base_data,
+					  u32 *base_vector)
+{
+	struct ath11k_ahb *ab_ahb = ath11k_ahb_priv(ab);
+
+	if (ab_ahb->snoc_ahb)
+		return -ENOPROTOOPT;
+
+	return ath11k_pcic_get_user_msi_assignment(ab, user_name, num_vectors,
+						   user_base_data, base_vector);
+}
+
+/* SNOC register access modes (derived from the stock driver):
+ * 0 = plain MMIO, 1 = stock "PCIE_REMAP_1M_BAR_CTRL" selector window,
+ * 2 = CE block direct + selector window for everything above 512 KiB
+ */
+static uint ath11k_snoc_reg_mode = 4;
+module_param_named(snoc_reg_mode, ath11k_snoc_reg_mode, uint, 0644);
+MODULE_PARM_DESC(snoc_reg_mode,
+		 "0 mmio, 1 selector window, 2 CE direct + selector, 3 vendor static map, 4 static map + CE direct");
+
+/* the stock qca6750 HAL uses the static window map (hal_get_window_address_6750):
+ * UMAC -> window 1, CE -> window 2, CMEM -> window 3, where the window is
+ * selected by (offset >> 19) & 0x3f
+ */
+#define ATH11K_SNOC_UMAC_WINDOW		0x14
+#define ATH11K_SNOC_CE_WINDOW		0x37
+#define ATH11K_SNOC_CMEM_WINDOW		0x02
+
+#define ATH11K_SNOC_WINDOW_START	0x80000
+#define ATH11K_SNOC_WINDOW_RANGE_MASK	0x7ffff
+#define ATH11K_SNOC_WINDOW_REG		0x310c
+#define ATH11K_SNOC_WINDOW_ENABLE	0x40000000
+#define ATH11K_SNOC_CE_START		0x240000
+#define ATH11K_SNOC_CE_END		0x260000
+
+static bool ath11k_ahb_snoc_windowed(struct ath11k_base *ab, u32 offset)
+{
+	if (ath11k_snoc_reg_mode == 0 || ath11k_snoc_reg_mode >= 3)
+		return false;
+
+	if (offset < ATH11K_SNOC_WINDOW_START)
+		return false;
+
+	if (ath11k_snoc_reg_mode == 2 && offset >= ATH11K_SNOC_CE_START &&
+	    offset < ATH11K_SNOC_CE_END)
+		return false;
+
+	return true;
+}
+
+/* stock static window map: no selector register, the window comes from a
+ * fixed table indexed by the address itself
+ */
+static int ath11k_ahb_snoc_static_window(u32 offset, u32 *addr)
+{
+	u32 window = (offset >> 19) & 0x3f;
+	u32 scale;
+
+	switch (window) {
+	case ATH11K_SNOC_UMAC_WINDOW:
+		scale = 1;
+		break;
+	case ATH11K_SNOC_CE_WINDOW:
+		scale = 2;
+		break;
+	case ATH11K_SNOC_CMEM_WINDOW:
+		scale = 3;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	*addr = scale * ATH11K_SNOC_WINDOW_START +
+		(offset & ATH11K_SNOC_WINDOW_RANGE_MASK);
+
+	return 0;
+}
+
+static bool ath11k_ahb_snoc_ce_direct(struct ath11k_base *ab, u32 offset)
+{
+	return ath11k_snoc_reg_mode == 4 && offset >= ATH11K_SNOC_CE_START &&
+	       offset < ATH11K_SNOC_CE_END;
+}
+
+static void ath11k_ahb_snoc_select_window(struct ath11k_base *ab, u32 offset)
+{
+	u32 window = (offset >> 19) & 0x3f;
+
+	iowrite32(ATH11K_SNOC_WINDOW_ENABLE | window,
+		  ab->mem + ATH11K_SNOC_WINDOW_REG);
+	ioread32(ab->mem + ATH11K_SNOC_WINDOW_REG);
+}
+
+static void ath11k_ahb_window_write32_snoc(struct ath11k_base *ab, u32 offset,
+					   u32 value)
+{
+	u32 addr;
+
+	if (ath11k_snoc_reg_mode >= 3 && !ath11k_ahb_snoc_ce_direct(ab, offset)) {
+		if (ath11k_ahb_snoc_static_window(offset, &addr)) {
+			ath11k_warn(ab, "snoc: no static window for 0x%x\n",
+				    offset);
+			iowrite32(value, ab->mem + offset);
+			return;
+		}
+
+		iowrite32(value, ab->mem + addr);
+		return;
+	}
+
+	if (!ath11k_ahb_snoc_windowed(ab, offset)) {
+		iowrite32(value, ab->mem + offset);
+		return;
+	}
+
+	ath11k_ahb_snoc_select_window(ab, offset);
+	iowrite32(value, ab->mem + ATH11K_SNOC_WINDOW_START +
+		  (offset & ATH11K_SNOC_WINDOW_RANGE_MASK));
+}
+
+static u32 ath11k_ahb_window_read32_snoc(struct ath11k_base *ab, u32 offset)
+{
+	u32 addr;
+
+	if (ath11k_snoc_reg_mode >= 3 && !ath11k_ahb_snoc_ce_direct(ab, offset)) {
+		if (ath11k_ahb_snoc_static_window(offset, &addr))
+			return ioread32(ab->mem + offset);
+
+		return ioread32(ab->mem + addr);
+	}
+
+	if (!ath11k_ahb_snoc_windowed(ab, offset))
+		return ioread32(ab->mem + offset);
+
+	ath11k_ahb_snoc_select_window(ab, offset);
+	return ioread32(ab->mem + ATH11K_SNOC_WINDOW_START +
+			(offset & ATH11K_SNOC_WINDOW_RANGE_MASK));
+}
+
+/* one-shot bring-up probe: find where the WCSS register blocks really live.
+ * Every access goes through copy_from_kernel_nofault() so a dead address is
+ * reported instead of taking the whole worker down.
+ */
+static void ath11k_ahb_snoc_probe_regs(struct ath11k_base *ab)
+{
+	static const u32 offs[] = {
+		0x0, 0x30000, 0x30064, 0x32064, 0x240000, 0x240038,
+		0x80000, 0x100000, 0x180000, 0x200000, 0x400000,
+		0x600000, 0x800000, 0xa00000, 0xa34874, 0xc00000,
+		0x1000000,
+	};
+	struct platform_device *pdev = ab->pdev;
+	struct resource *res;
+	phys_addr_t base;
+	int i;
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res)
+		return;
+
+	base = res->start;
+
+	for (i = 0; i < ARRAY_SIZE(offs); i++) {
+		phys_addr_t pa = (base + offs[i]) & PAGE_MASK;
+		u32 skip = (base + offs[i]) & ~PAGE_MASK;
+		void __iomem *va;
+		u32 val = 0;
+		long ret;
+
+		va = ioremap(pa, PAGE_SIZE);
+		if (!va) {
+			ath11k_info(ab, "probe +%#x: ioremap failed\n", offs[i]);
+			continue;
+		}
+
+		ret = copy_from_kernel_nofault(&val, va + skip, sizeof(val));
+		ath11k_info(ab, "probe +%#x (%pa): %s val=%#x\n", offs[i], &pa,
+			    ret ? "DEAD" : "live", val);
+		iounmap(va);
+	}
+}
+
+static const struct ath11k_pci_ops ath11k_ahb_pci_ops_snoc = {
+	.wakeup = NULL,
+	.get_msi_irq = ath11k_ahb_get_msi_irq_wcn6750,
+	.window_write32 = ath11k_ahb_window_write32_snoc,
+	.window_read32 = ath11k_ahb_window_read32_snoc,
+};
+
 static const struct ath11k_hif_ops ath11k_ahb_hif_ops_wcn6750 = {
 	.start = ath11k_pcic_start,
 	.stop = ath11k_pcic_stop,
@@ -815,7 +1046,7 @@ static const struct ath11k_hif_ops ath11k_ahb_hif_ops_wcn6750 = {
 	.irq_enable = ath11k_pcic_ext_irq_enable,
 	.irq_disable = ath11k_pcic_ext_irq_disable,
 	.get_msi_address =  ath11k_pcic_get_msi_address,
-	.get_user_msi_vector = ath11k_pcic_get_user_msi_assignment,
+	.get_user_msi_vector = ath11k_ahb_get_user_msi_vector,
 	.map_service_to_pipe = ath11k_pcic_map_service_to_pipe,
 	.power_down = ath11k_ahb_power_down,
 	.power_up = ath11k_ahb_power_up,
@@ -932,6 +1163,28 @@ static int ath11k_ahb_setup_resources(struct ath11k_base *ab)
 	if (ab->hw_params.hybrid_bus_type)
 		return ath11k_ahb_setup_msi_resources(ab);
 
+	if (ath11k_ahb_priv(ab)->snoc_ahb && ath11k_snoc_membase_mib) {
+		phys_addr_t start;
+		size_t len = (size_t)ath11k_snoc_membase_mib * SZ_1M;
+
+		mem_res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+		if (!mem_res)
+			return -ENOENT;
+
+		start = mem_res->start;
+		mem = devm_ioremap(&pdev->dev, start, len);
+		if (!mem)
+			return -ENOMEM;
+
+		ab->mem = mem;
+		ab->mem_len = len;
+		ab->mem_ce = ab->mem;
+
+		ath11k_info(ab, "snoc mode: membase %zu MiB @%pa\n", len / SZ_1M,
+			    &start);
+		return 0;
+	}
+
 	mem = devm_platform_get_and_ioremap_resource(pdev, 0, &mem_res);
 	if (IS_ERR(mem)) {
 		dev_err(&pdev->dev, "ioremap error\n");
@@ -940,6 +1193,9 @@ static int ath11k_ahb_setup_resources(struct ath11k_base *ab)
 
 	ab->mem = mem;
 	ab->mem_len = resource_size(mem_res);
+	/* the SNOC variant has no separate CE window */
+	if (ath11k_ahb_priv(ab)->snoc_ahb)
+		ab->mem_ce = ab->mem;
 
 	return 0;
 }
@@ -1191,10 +1447,51 @@ static int ath11k_ahb_probe(struct platform_device *pdev)
 	if (ret)
 		goto err_core_free;
 
+	/* The SNOC ("icnss") firmware variant has no QMI DEVICE_INFO/BAR and no
+	 * MSI vectors: the register block is the DT "membase" and every copy
+	 * engine has its own GIC interrupt. Everything else (windowed register
+	 * access, QMI/WMI/HTT) is unchanged.
+	 */
+	if (of_property_present(pdev->dev.of_node, "qcom,snoc-ahb")) {
+		ath11k_info(ab, "snoc mode: membase registers, per-CE interrupts\n");
+		struct ath11k_hw_regs *regs;
+
+		ath11k_ahb_priv(ab)->snoc_ahb = true;
+		ab->hw_params.hybrid_bus_type = false;
+		ab->hw_params.fixed_fw_mem = ath11k_snoc_fixed_mem;
+
+		/* the SNOC register block is not the PCI BAR: no windowing */
+		ath11k_pcic_register_pci_ops(ab, &ath11k_ahb_pci_ops_snoc);
+
+		/* adrastea host register map: one 0x1000 block per CE, the src
+		 * ring registers at +0x00 and the dst ring registers at +0x0c
+		 * (see ADRASTEA_A_WCSS_HM_A_WIFI_APB_1_A_WFSS_CE0_* in the
+		 * vendor adrastea_reg_def.h)
+		 */
+		regs = devm_kmemdup(&pdev->dev, ab->hw_params.regs,
+				    sizeof(*regs), GFP_KERNEL);
+		if (!regs) {
+			ret = -ENOMEM;
+			goto err_core_free;
+		}
+		regs->hal_seq_wcss_umac_ce0_src_reg = 0x00240000;
+		regs->hal_seq_wcss_umac_ce0_dst_reg = 0x0024000c;
+		regs->hal_seq_wcss_umac_ce1_src_reg = 0x00241000;
+		regs->hal_seq_wcss_umac_ce1_dst_reg = 0x0024100c;
+		ab->hw_params.regs = regs;
+	}
+
 	ret = ath11k_ahb_setup_resources(ab);
 	if (ret)
 		goto err_core_free;
 
+	/* NOTE: must not run in the probe path: the bind is issued from PID 1,
+	 * so a dead address there kills init and panics the box.  Kept behind
+	 * a parameter for a future workqueue based probe.
+	 */
+	if (ath11k_snoc_probe && ath11k_ahb_priv(ab)->snoc_ahb)
+		ath11k_ahb_snoc_probe_regs(ab);
+
 	ret = ath11k_ahb_ce_remap(ab);
 	if (ret)
 		goto err_core_free;
diff --git a/drivers/net/wireless/ath/ath11k/ahb.h b/drivers/net/wireless/ath/ath11k/ahb.h
