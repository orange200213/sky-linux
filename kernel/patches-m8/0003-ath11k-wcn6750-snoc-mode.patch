+static int ath11k_qmi_cal_report_send(struct ath11k_base *ab)
+{
+	struct qmi_wlfw_cal_report_req_msg_v01 req = {};
+	struct qmi_wlfw_cal_report_resp_msg_v01 resp = {};
+	struct qmi_txn txn;
+	int ret;
+
+	req.meta_data_len = 0;
+
+	ret = qmi_txn_init(&ab->qmi.handle, &txn,
+			   qmi_wlfw_cal_report_resp_msg_v01_ei, &resp);
+	if (ret < 0)
+		return ret;
+
+	ret = qmi_send_request(&ab->qmi.handle, NULL, &txn,
+			       QMI_WLFW_CAL_REPORT_REQ_V01,
+			       QMI_WLFW_CAL_REPORT_REQ_MSG_V01_MAX_LEN,
+			       qmi_wlfw_cal_report_req_msg_v01_ei, &req);
+	if (ret < 0) {
+		qmi_txn_cancel(&txn);
+		ath11k_warn(ab, "failed to send cal report request: %d\n", ret);
+		return ret;
+	}
+
+	ret = qmi_txn_wait(&txn, msecs_to_jiffies(ATH11K_QMI_WLANFW_TIMEOUT_MS));
+	if (ret < 0) {
+		ath11k_warn(ab, "failed to wait cal report request: %d\n", ret);
+		return ret;
+	}
+
+	if (resp.resp.result != QMI_RESULT_SUCCESS_V01) {
+		ath11k_warn(ab, "cal report request rejected: %d %d\n",
+			    resp.resp.result, resp.resp.error);
+		return -EINVAL;
+	}
+
+	ath11k_info(ab, "cal report sent\n");
+
+	return 0;
+}
