+			      QMI_WLANFW_MAX_DATA_SIZE_V01);
+		if (remaining > chunk) {
+			req->data_len = chunk;
 		} else {
 			req->data_len = remaining;
 			req->end = 1;
@@ -2976,7 +3262,32 @@ static int ath11k_qmi_event_load_bdf(struct ath11k_qmi *qmi)
 		return ret;
 	}
 
-	if (ab->hw_params.supports_regdb)
+	if (ab->hw_params.supports_regdb && ath11k_regdb_download)
+		ath11k_qmi_load_bdf_qmi(ab, true);
