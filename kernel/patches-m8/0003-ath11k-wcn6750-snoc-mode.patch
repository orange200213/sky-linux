 		.ce_count = 9,
 		.target_ce_config = ath11k_target_ce_config_wlan_qca6390,
@@ -1828,6 +1834,13 @@ int ath11k_core_fetch_board_data_api_1(struct ath11k_base *ab,
 }
 
