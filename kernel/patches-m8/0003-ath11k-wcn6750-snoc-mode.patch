 bool ath11k_cold_boot_cal = 1;
 EXPORT_SYMBOL(ath11k_cold_boot_cal);
+/* BDF download knobs, used while bringing up the SNOC ("icnss") variant:
+ * the stock firmware rejects the upstream message with QMI error 19.
+ */
+static uint ath11k_bdf_chunk = QMI_WLANFW_MAX_DATA_SIZE_V01;
+module_param_named(bdf_chunk, ath11k_bdf_chunk, uint, 0644);
+MODULE_PARM_DESC(bdf_chunk, "BDF download segment size in bytes");
+
+static int ath11k_bdf_file_id = -1;
+module_param_named(bdf_file_id, ath11k_bdf_file_id, int, 0644);
+MODULE_PARM_DESC(bdf_file_id, "override the BDF download file_id (-1 = board_id)");
+
+static bool ath11k_bdf_total_full;
+module_param_named(bdf_total_full, ath11k_bdf_total_full, bool, 0644);
+MODULE_PARM_DESC(bdf_total_full,
+		 "send the whole file size as total_size instead of the remaining bytes");
+
+/* where to send host_cap in SNOC mode: 0 = never, 1 = before the MSA
+ * handshake, 2 = after it (upstream order)
+ */
+static uint ath11k_snoc_host_cap = 1;
+module_param_named(snoc_host_cap, ath11k_snoc_host_cap, uint, 0644);
