@@ -3000,10 +3311,74 @@ static int ath11k_qmi_event_server_arrive(struct ath11k_qmi *qmi)
 		return ret;
 	}
 
-	ret = ath11k_qmi_host_cap_send(ab);
-	if (ret < 0) {
-		ath11k_warn(ab, "failed to send qmi host cap: %d\n", ret);
-		return ret;
+	if (ath11k_qmi_is_snoc(ab)) {
+		if (ath11k_snoc_host_cap == 1) {
