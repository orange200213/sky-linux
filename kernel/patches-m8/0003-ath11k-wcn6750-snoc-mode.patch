+	u64 region_addr;
+	u32 size;
+	u8 secure_flag;
+} __packed;
+
+struct wlfw_msa_info_req_msg_v01 {
+	u64 msa_addr;
+	u32 size;
+} __packed;
+
+struct wlfw_msa_info_resp_msg_v01 {
